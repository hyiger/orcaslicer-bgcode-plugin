;TYPE:Custom
; Filament-specific end gcode
G1 Z21 F720 ; move print head up
G1 E-1 F2400 ; additional retraction
M104 S0 ; turn off temperature
M140 S0 ; turn off heatbed
M141 S0 ; disable chamber control
M107 ; turn off fan
G1 X242 Y-9 F10200 ; park
G4 ; wait
M572 S0 ; reset PA
M84 X Y E ; disable motors
; max_layer_z = 20
M73 P100 R0
